{
  "name": "miplata",
  "version": "0.3.1",
  "private": true,
  "description": "MiPlata: gastos para Windows con acceso desde iPhone, en español neutro y pesos chilenos",
  "author": "xdeveloping21",
  "contributors": [
    "Valentin Tarnovsky (autor de MisGastos, proyecto original)"
  ],
  "license": "MIT",
  "repository": "https://github.com/xdeveloping21/MiPlata",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:win": "electron-builder --win dir",
    "build:release": "electron-builder --win nsis"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "png-to-ico": "3.0.1"
  },
  "build": {
    "appId": "cl.miplata.app",
    "productName": "MiPlata",
    "directories": {
      "output": "dist"
    },
    "files": [
      "LICENSE",
      "index.html",
      "apple-touch-icon.png",
      "manifest.webmanifest",
      "styles.css",
      "app.js",
      "category-icons.js",
      "runtime.js",
      "assets/**/*",
      "desktop/**/*",
      "initial-state.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/miplata.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "MiPlata-Setup-${version}.${ext}"
    }
  }
}
